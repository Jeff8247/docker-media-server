[Unit]
Description=Update the MediaServer Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_DIR@
Environment=MEDIASERVER_PROJECT_DIR=@PROJECT_DIR@
ExecStart=/usr/local/sbin/mediaserver-update
TimeoutStartSec=30min
