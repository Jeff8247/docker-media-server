# Public naming and direct-access addresses
DOMAIN=example.com
SERVER_IP=203.0.113.10
# The server's actual LAN address. If omitted, direct services bind to loopback.
LAN_IP=192.168.1.10
LOCAL_SUBNET=192.168.1.0/24

ACME_EMAIL=admin@example.com
TZ=Australia/Sydney
PUID=1000
PGID=1000
# Media/application root on the mounted RAID; see SETUP.md.
ROOT_MEDIA_DIR=/mnt/media/plex

VPN_USER=
VPN_PASSWORD=
VPN_REGION=Switzerland

CF_DNS_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# Retained only for a v14 rollback. wg-easy v15 performs account setup in its UI.
PASSWORD_HASH=
